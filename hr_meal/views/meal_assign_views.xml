<odoo>
    <record id="view_meal_assign_form" model="ir.ui.view">
        <field name="name">meal.assign.form</field>
        <field name="model">meal.assign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id" 
                            widget="many2one_avatar" 
                            options="{'no_create': True, 'no_create_edit': True}"  
                            context="{'exclude_assigned_for_meal': True}" 
                        />
                        <field name="meal_type_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="meal_group_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_meal_assign_list" model="ir.ui.view">
        <field name="name">meal.assign.list</field>
        <field name="model">meal.assign</field>
        <field name="arch" type="xml">
            <list>
                <field name="department_id"/>
                <field name="employee_id" widget="many2one_avatar"/>
                <field name="meal_type_ids" widget="many2many_tags" />
                <field name="meal_group_id" />
            </list>
        </field>
    </record>

    <record id="view_meal_assign_search" model="ir.ui.view">
        <field name="name">meal.assign.search</field>
        <field name="model">meal.assign</field>
        <field name="arch" type="xml">
            <search string="Assign Meals Search">

                <field name="employee_id"/>
                <field name="meal_type_ids"/>
                <field name="meal_group_id"/>
                <group expand="0" string="Group By">
                    <filter
                        string="Meal Group"
                        name="group_meal_group_id"
                        context="{'group_by': 'meal_group_id'}"/>
                    <!-- <filter
                        string="Department"
                        name="group_department_id"
                        context="{'group_by': 'department_id'}"/> -->
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_list_meal_unassigned" model="ir.ui.view">
        <field name="name">hr.employee.list.meal.unassigned</field>
        <field name="model">hr.employee</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list>
                <field name="avatar_128" string="Photo" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="mobile_phone" string="Mobile"/>
                <field name="department_id"/>
                <field name="job_id" string="Designation"/>
                <button name="action_assign_meal" type="object"
                        string="Assign Meal" icon="fa-cutlery"
                        class="btn-primary"/>
            </list>
        </field>
    </record>

    <!-- Unassigned Employees: active employees with no meal.assign record -->
    <record id="action_unassigned_meal_employees" model="ir.actions.act_window">
        <field name="name">Unassigned Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_employee_list_meal_unassigned"/>
        <field name="domain">[('is_meal_assigned', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All employees have a meal assignment.</p>
        </field>
    </record>
</odoo>